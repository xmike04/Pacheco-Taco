---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import InfoCard from '../components/InfoCard.astro';
import MenuItem from '../components/MenuItem.astro';
import Button from '../components/Button.astro';
import Photo from '../components/Photo.astro';
import Tag from '../components/Tag.astro';
import { site, hours, dayNames, formatRange } from '../data/site';
import { startHere, findItem, type MenuItem as Item } from '../data/menu';
import { photos } from '../data/photos';
import { restaurantSchema } from '../data/schema';

const origin = Astro.site?.origin;
const picks = startHere.map(findItem).filter((i): i is Item => Boolean(i));
const strip = photos.filter((p) => p.slot === 'strip');
const storyPhoto = photos.find((p) => p.slot === 'story');
const visitPhoto = photos.find((p) => p.slot === 'visit');
---

<Base
  title="Pacheco Taco N Burger | Smash Burgers & Tacos in Dallas"
  description={`Family-owned smash burgers and street tacos in The Cedars, Dallas — inside Four Corners Brewing Co., 1311 S Ervay St. Call ${site.phone.display}.`}
  path="/"
  jsonLd={[restaurantSchema(origin)]}
  preloadScript
>
  <Hero />
  <InfoCard />

  <section class="section" id="start" aria-labelledby="start-h">
    <div class="container">
      <header class="section-head">
        <p class="pt-eyebrow">Start here</p>
        <h2 class="display-lg" id="start-h">First time? Order one of these.</h2>
      </header>
      <div class="pt-menu pt-menu--picks">
        {picks.map((item) => <MenuItem item={item} />)}
      </div>
      <div class="section-cta">
        <Button href="/menu/" variant="primary" iconAfter="arrow-right">See the full menu</Button>
      </div>
    </div>
  </section>

  {
    strip.length >= 2 && (
      <section class="section section--tight" aria-labelledby="strip-h">
        <div class="container">
          <header class="section-head">
            <p class="pt-eyebrow">The goods</p>
            <h2 class="display-lg" id="strip-h">
              Fresh off the flat-top
            </h2>
          </header>
          <div class="strip" style={`--cols:${strip.length <= 5 ? strip.length : 3}`}>
            {strip.map((p) => (
              <Photo entry={p} widths={[360, 560, 800]} sizes="(min-width: 721px) 30vw, 45vw" class="strip__photo" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section story" id="story" aria-labelledby="story-h">
    <div class="container story__grid">
      <div class="story__copy">
        <p class="pt-eyebrow">Our story</p>
        <h2 class="display-lg" id="story-h">Mom &amp; son. Scratch kitchen.</h2>
        <p class="lead">
          We're a mom-and-son shop doing what we love: smash burgers, street tacos and aguas frescas, all made from
          scratch.
        </p>
        <p>
          You'll find us inside {site.inside} in {site.neighborhood}. Order at the counter, and get it while it's hot.
        </p>
      </div>
      <div class:list={['story__art', storyPhoto && 'story__art--photo']}>
        {
          storyPhoto ? (
            <>
              <Photo entry={storyPhoto} widths={[480, 720, 960]} sizes="(min-width: 961px) 520px, 90vw" />
              <img
                class="sticker sticker--amor"
                src="/assets/stickers/hecho-con-amor.svg"
                alt=""
                width="400"
                height="400"
                loading="lazy"
              />
            </>
          ) : (
            <div class="story__panel">
              <img
                class="sticker sticker--amor"
                src="/assets/stickers/hecho-con-amor.svg"
                alt=""
                width="400"
                height="400"
                loading="lazy"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" id="visit" aria-labelledby="visit-h">
    <div class="container visit__grid">
      <div class="visit__details">
        <p class="pt-eyebrow">Visit</p>
        <h2 class="display-lg" id="visit-h">Come hungry.</h2>
        <address class="visit__address">
          {site.address.street}<br />
          {site.address.city}, {site.address.region}
          {site.address.postalCode}
        </address>
        <p class="lead">Find us inside {site.inside} in {site.neighborhood}.</p>
        <ul class="tags-row" aria-label="Good to know">
          {
            site.amenities.map((a) => (
              <li>
                <Tag>{a}</Tag>
              </li>
            ))
          }
        </ul>
        <div class="visit__actions">
          <Button href={site.links.directions} variant="primary" icon="map-pin" external>Get directions</Button>
          <Button href={`tel:${site.phone.tel}`} variant="ghost" icon="phone">Call {site.phone.display}</Button>
        </div>
        {
          visitPhoto && (
            <Photo entry={visitPhoto} widths={[480, 720, 960]} sizes="(min-width: 961px) 520px, 90vw" class="visit__photo" />
          )
        }
      </div>

      <div class="hours-card" id="hours">
        <div class="hours-card__head">
          <h3 class="hours-card__title">Hours</h3>
          <span class="open-status" data-open-status hidden></span>
        </div>
        <table class="hours-table">
          <caption class="sr-only">Opening hours</caption>
          <tbody>
            {
              hours.map((h) => (
                <tr data-day={h.day}>
                  <th scope="row">{dayNames[h.day]}</th>
                  <td>{formatRange(h)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="hours-card__note">
          Hours change now and then — give us a call: <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
