---
// Masa (light) / Noche (dark). The label never changes — state is carried by aria-pressed.
// Hidden until the head script has set data-theme, so it never shows as a dead control without JS.
---

<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
  <span class="theme-toggle__dot" aria-hidden="true"></span>
  Noche (dark) mode
</button>
