---
import '../styles/tokens.css';
import '../styles/bundle.css';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyActions from '../components/StickyActions.astro';
import { hoursPayload } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Site-relative path, e.g. "/menu/" — used for canonical + og:url when SITE_URL is known. */
  path: string;
  current?: 'menu';
  jsonLd?: object[];
  noindex?: boolean;
  /** Preload the script face (Shrikhand) — only on pages that actually set type in it. */
  preloadScript?: boolean;
}

const { title, description, path, current, jsonLd = [], noindex = false, preloadScript = false } = Astro.props;

const origin = Astro.site ? Astro.site.origin : undefined;
const canonical = origin ? new URL(path, origin).href : undefined;
const ogImage = origin ? `${origin}/assets/social/og-image.png` : undefined;
const ogAlt = 'Pacheco Taco N Burger — smash burgers, tacos, aguas frescas. 1311 S Ervay St, Dallas.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#fbf3e4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17110d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/assets/logos/pacheco-favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:site_name" content="Pacheco Taco N Burger" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ogAlt} />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/BowlbyOne-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/WorkSans-VF.woff2" as="font" type="font/woff2" crossorigin />
    {
      preloadScript && (
        <link rel="preload" href="/fonts/Shrikhand-Regular.woff2" as="font" type="font/woff2" crossorigin />
      )
    }

    <!-- Set the theme before first paint (no flash). Saved choice wins, else the OS setting. -->
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('pt-theme');
        } catch (e) {}
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="pt-root">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <StickyActions />
    <script type="application/json" id="pt-hours" set:html={JSON.stringify(hoursPayload)} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
